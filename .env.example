# Public Supabase values. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required in production. Cloudflare Turnstile protects sign-in, registration, and password reset.
NEXT_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only database connection. Use Supabase's transaction pooler for Vercel.
DATABASE_URL=postgresql://postgres:password@host:6543/postgres?pgbouncer=true
# Optional: Supabase CA certificate with line breaks encoded as \\n. When it is
# absent, production still uses TLS but permits the pooler's certificate chain.
DATABASE_SSL_CA=

# Used by Prisma migrations. Never expose this value in client code.
DIRECT_URL=postgresql://postgres:password@host:5432/postgres

# Application origin, required for secure redirect construction in later milestones.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Administrators must re-authenticate after this absolute session lifetime.
ADMIN_SESSION_MAX_AGE_HOURS=12

# Payment and order-notification integrations.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Amidaddy <orders@send.amidaddy.in>
# Optional private copy of each confirmed-order email for the store team.
ORDER_NOTIFICATION_EMAIL=amidaddy.in@gmail.com
CRON_SECRET=
