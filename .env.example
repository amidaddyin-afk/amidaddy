# Public Supabase values. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only database connection. Use Supabase's transaction pooler for Vercel.
DATABASE_URL=postgresql://postgres:password@host:6543/postgres?pgbouncer=true

# Used by Prisma migrations. Never expose this value in client code.
DIRECT_URL=postgresql://postgres:password@host:5432/postgres

# Application origin, required for secure redirect construction in later milestones.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Added in the payment milestone.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
