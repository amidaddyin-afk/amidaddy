generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model Profile {
  id                String             @id @db.Uuid
  email             String             @unique
  fullName          String?            @map("full_name")
  role              UserRole           @default(CUSTOMER)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  orders            Order[]
  couponRedemptions CouponRedemption[]
  leads             Lead[]

  @@map("profiles")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  event     String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Brand {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  products  Product[]

  @@map("brands")
}

model Category {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  products  Product[]

  @@map("categories")
}

model Product {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String              @unique
  sku               String              @unique
  barcode           String?             @unique
  description       String
  mrp               Decimal             @db.Decimal(12, 2)
  sellingPrice      Decimal             @map("selling_price") @db.Decimal(12, 2)
  offerPrice        Decimal?            @map("offer_price") @db.Decimal(12, 2)
  gstRate           Decimal             @default(18) @map("gst_rate") @db.Decimal(5, 2)
  stock             Int                 @default(0)
  reserved          Int                 @default(0)
  lowStockAt        Int                 @default(5) @map("low_stock_at")
  active            Boolean             @default(false)
  featured          Boolean             @default(false)
  isNew             Boolean             @default(false) @map("is_new")
  bestSeller        Boolean             @default(false) @map("best_seller")
  seoTitle          String?             @map("seo_title")
  seoDescription    String?             @map("seo_description")
  fragranceFamily   String?             @map("fragrance_family")
  concentration     String?
  genderPositioning String?             @map("gender_positioning")
  topNotes          String[]            @default([]) @map("top_notes")
  heartNotes        String[]            @default([]) @map("heart_notes")
  baseNotes         String[]            @default([]) @map("base_notes")
  longevity         String?
  mood              String?
  occasion          String?
  story             String?
  collection        String              @default("unisex")
  packSize          Int                 @default(1) @map("pack_size")
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  brandId           String?             @map("brand_id") @db.Uuid
  categoryId        String?             @map("category_id") @db.Uuid
  brand             Brand?              @relation(fields: [brandId], references: [id])
  category          Category?           @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  variants          ProductVariant[]
  movements         InventoryMovement[]

  @@index([active, deletedAt])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductVariant {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String      @map("product_id") @db.Uuid
  name       String
  sku        String      @unique
  pricePaise Int         @map("price_paise")
  mrpPaise   Int         @map("mrp_paise")
  stock      Int         @default(0)
  reserved   Int         @default(0)
  lowStockAt Int         @default(5) @map("low_stock_at")
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, name])
  @@index([productId, active])
  @@map("product_variants")
}

model ProductImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  url         String
  alt         String
  position    Int      @default(0)
  variantName String?  @map("variant_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_images")
}

enum InventoryMovementType {
  ADJUSTMENT
  RESERVATION
  RELEASE
  SALE
  RETURN
}

model InventoryMovement {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String                @map("product_id") @db.Uuid
  type      InventoryMovementType
  quantity  Int
  reason    String?
  actorId   String?               @map("actor_id") @db.Uuid
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product               @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@map("inventory_movements")
}

enum OrderStatus {
  PAYMENT_PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum CouponType {
  PERCENT
  FIXED
}

model Order {
  id                 String             @id
  customerId         String?            @map("customer_id") @db.Uuid
  email              String
  customerName       String             @map("customer_name")
  phone              String
  address            String
  city               String?
  state              String?
  postalCode         String?            @map("postal_code")
  country            String             @default("IN")
  subtotalPaise      Int                @map("subtotal_paise")
  discountPaise      Int                @default(0) @map("discount_paise")
  shippingPaise      Int                @default(0) @map("shipping_paise")
  taxPaise           Int                @default(0) @map("tax_paise")
  totalPaise         Int                @map("total_paise")
  status             OrderStatus        @default(PAYMENT_PENDING)
  paymentStatus      PaymentStatus      @default(UNPAID) @map("payment_status")
  couponCode         String?            @map("coupon_code")
  paymentOrderId     String?            @unique @map("payment_order_id")
  paymentId          String?            @unique @map("payment_id")
  courierName        String?            @map("courier_name")
  trackingNumber     String?            @map("tracking_number")
  trackingUrl        String?            @map("tracking_url")
  expiresAt          DateTime?          @map("expires_at") @db.Timestamptz(6)
  shippedAt          DateTime?          @map("shipped_at") @db.Timestamptz(6)
  deliveredAt        DateTime?          @map("delivered_at") @db.Timestamptz(6)
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?            @map("cancellation_reason")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer           Profile?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  refunds            Refund[]
  couponRedemptions  CouponRedemption[]
  campaignSends      CampaignSend[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id             BigInt          @id @default(autoincrement())
  orderId        String          @map("order_id")
  variantId      String?         @map("variant_id") @db.Uuid
  productRef     String          @map("product_ref")
  name           String
  size           String
  quantity       Int
  unitPricePaise Int             @map("unit_price_paise")
  gstRate        Decimal         @default(18) @map("gst_rate") @db.Decimal(5, 2)
  taxPaise       Int             @default(0) @map("tax_paise")
  lineTotalPaise Int             @map("line_total_paise")
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Coupon {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String             @unique
  type             CouponType
  value            Int
  minSubtotalPaise Int                @default(0) @map("min_subtotal_paise")
  maxDiscountPaise Int?               @map("max_discount_paise")
  usageLimit       Int?               @map("usage_limit")
  perCustomerLimit Int                @default(1) @map("per_customer_limit")
  active           Boolean            @default(true)
  startsAt         DateTime?          @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime?          @map("ends_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  redemptions      CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId    String   @map("coupon_id") @db.Uuid
  orderId     String   @map("order_id")
  customerId  String?  @map("customer_id") @db.Uuid
  email       String
  amountPaise Int      @map("amount_paise")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  coupon      Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer    Profile? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([couponId, email])
  @@map("coupon_redemptions")
}

model Refund {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String       @map("order_id")
  paymentRefundId String?      @unique @map("payment_refund_id")
  amountPaise     Int          @map("amount_paise")
  reason          String
  status          RefundStatus @default(PENDING)
  requestedBy     String?      @map("requested_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt     DateTime?    @map("processed_at") @db.Timestamptz(6)
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("refunds")
}

model WebhookEvent {
  id          String   @id
  provider    String
  event       String
  payloadHash String   @map("payload_hash")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("webhook_events")
}

model NotificationLog {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String?   @map("order_id")
  recipient  String
  template   String
  status     String
  providerId String?   @map("provider_id")
  campaign   String?
  attempts   Int       @default(0)
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt     DateTime? @map("sent_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("notification_logs")
}

model StoreSetting {
  id                     Int      @id @default(1)
  supportEmail           String   @default("support@amidaddy.in") @map("support_email")
  supportPhone           String?  @map("support_phone")
  shippingFeePaise       Int      @default(9900) @map("shipping_fee_paise")
  freeShippingAbovePaise Int      @default(59900) @map("free_shipping_above_paise")
  cancellationMessage    String   @default("Orders can be cancelled before processing begins.") @map("cancellation_message")
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("store_settings")
}

model RequestRateLimit {
  scope        String
  identityHash String   @map("identity_hash")
  windowStart  DateTime @map("window_start") @db.Timestamptz(6)
  attempts     Int      @default(1)

  @@id([scope, identityHash, windowStart])
  @@map("request_rate_limits")
}

enum LeadStage {
  SUBSCRIBER
  SIGNED_UP
  CHECKOUT_STARTED
  ABANDONED
  CUSTOMER
  REPEAT_CUSTOMER
}

model Lead {
  email          String      @id
  fullName       String?     @map("full_name")
  phone          String?
  customerId     String?     @map("customer_id") @db.Uuid
  source         String      @default("SIGNUP")
  stage          LeadStage   @default(SUBSCRIBER)
  marketingOptIn Boolean     @default(true) @map("marketing_opt_in")
  unsubscribedAt DateTime?   @map("unsubscribed_at") @db.Timestamptz(6)
  signedUpAt     DateTime?   @map("signed_up_at") @db.Timestamptz(6)
  firstSeenAt    DateTime    @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt     DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  lastCheckoutAt DateTime?   @map("last_checkout_at") @db.Timestamptz(6)
  firstOrderAt   DateTime?   @map("first_order_at") @db.Timestamptz(6)
  lastOrderAt    DateTime?   @map("last_order_at") @db.Timestamptz(6)
  orderCount     Int         @default(0) @map("order_count")
  lifetimePaise  BigInt      @default(0) @map("lifetime_paise")
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer       Profile?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  events         LeadEvent[]

  @@index([stage, lastSeenAt])
  @@index([createdAt])
  @@index([customerId])
  @@map("leads")
}

model LeadEvent {
  id        BigInt   @id @default(autoincrement())
  email     String
  type      String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lead      Lead     @relation(fields: [email], references: [email], onDelete: Cascade)

  @@index([email, createdAt])
  @@map("lead_events")
}

model CampaignSend {
  id        BigInt   @id @default(autoincrement())
  email     String
  campaign  String
  orderId   String?  @map("order_id")
  status    String   @default("SENT")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Real uniqueness lives on campaign_sends_unique_idx, a NULL-collapsing
  // expression index the migration creates by hand -- Prisma's declarative
  // @@unique can't express coalesce(order_id, ''), so it is intentionally
  // left off this model to avoid claiming a constraint that doesn't exist.
  @@index([email, campaign, orderId])
  @@index([campaign, createdAt])
  @@map("campaign_sends")
}
